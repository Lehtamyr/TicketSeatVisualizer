generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShapeType {
  RECTANGLE
  SQUARE
  TRIANGLE
  POLYGON
  CIRCLE
  STAGE
}

enum SeatStatus {
  AVAILABLE
  HELD
  RESERVED
  BLOCKED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PricingTier {
  id          String    @id @default(uuid())
  layoutId    String?
  layout      VenueLayout? @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  name        String
  color       String
  basePrice   Float
  description String?
  salesEndDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections    Section[]
  seats       Seat[]

  @@index([layoutId])
}

model VenueLayout {
  id           String        @id @default(uuid())
  name         String
  canvasWidth  Int           @default(1200)
  canvasHeight Int           @default(800)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sections     Section[]
  pricingTiers PricingTier[]
  events       Event[]
}

model Event {
  id                  String        @id @default(uuid())
  title               String
  description         String?
  venueName           String
  termsAndConditions  String?
  startTime           DateTime
  endTime             DateTime?
  viewBoxWidth        Int           @default(1200)
  viewBoxHeight       Int           @default(800)
  layoutId            String?
  layout              VenueLayout?  @relation(fields: [layoutId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sections            Section[]
  reservations        Reservation[]

  @@index([layoutId])
}

model Section {
  id             String       @id @default(uuid())
  layoutId       String?
  layout         VenueLayout? @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  code           String
  shapeType      ShapeType
  geometry       Json
  pricingTierId  String?
  pricingTier    PricingTier? @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)
  price          Float
  color          String
  rowCount       Int          @default(0)
  seatsPerRow    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  seats          Seat[]

  @@index([layoutId])
  @@index([eventId])
  @@index([pricingTierId])
}

model Seat {
  id             String       @id @default(uuid())
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  row            String
  number         Int
  x              Float
  y              Float
  status         SeatStatus   @default(AVAILABLE)
  heldBy         String?
  priceOverride  Float?
  pricingTierId  String?
  pricingTier    PricingTier? @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)
  version        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reservationSeats ReservationSeat[]

  @@unique([sectionId, row, number])
  @@index([sectionId, status])
  @@index([pricingTierId])
}

model Reservation {
  id             String            @id @default(uuid())
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userSessionId  String
  status         ReservationStatus @default(PENDING)
  totalAmount    Float
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  seats          ReservationSeat[]
  orders         Order[]

  @@index([eventId, status])
  @@index([expiresAt])
}

model ReservationSeat {
  id             String      @id @default(uuid())
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seatId         String
  seat           Seat        @relation(fields: [seatId], references: [id], onDelete: Cascade)
  priceLocked    Float
  createdAt      DateTime    @default(now())

  @@unique([reservationId, seatId])
  @@index([seatId])
}

model Order {
  id             String        @id @default(uuid())
  reservationId  String
  reservation    Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  orderNumber    String        @unique
  customerName   String
  customerEmail  String
  customerPhone  String?
  identityType   String?
  identityNumber String?
  paymentMethod  String
  paymentStatus  PaymentStatus @default(PENDING)
  totalAmount    Float
  paymentRef     String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([reservationId])
  @@index([orderNumber])
  @@index([paymentStatus])
}
